# ===== ContentPilot（Gemini AI） =====
# Google AI Studio (https://aistudio.google.com/) で無料のAPIキーを発行して設定。
# Free枠で毎日一定量の生成が無料。ここを空にするとデモ出力（サンプル）が返ります。
GEMINI_API_KEY=

# 使用モデル（省略時は gemini-flash-lite-latest＝最新ライトモデルを自動追従）
# GEMINI_MODEL=gemini-flash-lite-latest

# ===== 収益化（Stripe） =====
# Stripe の Checkout Session で各プランを決済し、Webhook で有料プラン権限を付与します。
# 以下4つをVercelに設定してください（Stripe のライブモードで取得）。
# - STRIPE_SECRET_KEY: シークレットキー（sk_live_...）
# - STRIPE_WEBHOOK_SECRET: Webhook署名シークレット（whsec_live_...）
# - STRIPE_PRICE_STANDARD / STRIPE_PRICE_PRO: 各プランのPrice ID（price_live_...）
# 未設定の場合は決済ボタンが無効化されます。
STRIPE_SECRET_KEY=sk_live_xxxx                                      # Stripeシークレットキー
STRIPE_WEBHOOK_SECRET=whsec_live_xxxx                               # Webhook署名シークレット
STRIPE_PRICE_STANDARD=price_live_xxx                                # Standard(¥500)のPrice ID
STRIPE_PRICE_PRO=price_live_xxx                                     # Pro(¥900)のPrice ID

# ===== 利用制限（Upstash Redis / Vercel KV） =====
# Vercel の Redis (Upstash) インテグレーションを追加すると自動で設定されます。
# サーバー側で月次利用回数を記録し、Free枠の超過を API 側でも弾きます。
# 未設定の場合はサーバー側制限がスキップされ、クライアント（localStorage）のみで制限します。
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 表示用のProプラン価格（任意）
# NEXT_PUBLIC_PRO_PRICE=¥500/月

# ===== お問い合わせ送信（Resend・任意） =====
# 設定するとフォームから直接メールが送信されます。
# https://resend.com/ で無料登録し、APIキーと受信先メールアドレスを設定。
# 初回は送信元が onboarding@resend.dev になります（ドメイン検証で自ドメイン可）。
RESEND_API_KEY=re_xxxx
CONTACT_TO=your@email.com

# ===== Google AdSense（任意・収益化） =====
# 設定するとサイト全体に自動広告が表示されます（AdSense審査通過後）。
# https://adsense.google.com/ で登録し、発行されるクライアントID
# ca-pub-XXXXXXXXXXXXXX を設定してください。
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx

# ===== Supabase（ユーザー認証・任意） =====
# 設定するとヘッダーにログイン機能が表示され、ログイン中は
# 購入プラン・利用制限がユーザーIDに紐付き、複数デバイスで共有されます。
# 未設定の場合は従来の匿名（ブラウザ）モードで動作します。
# https://supabase.com/ で新規プロジェクトを作成し、
# Project Settings → API Keys から URL と anon public key を取得。
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxx
