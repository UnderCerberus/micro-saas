# ===== ContentPilot（Gemini AI） =====
# Google AI Studio (https://aistudio.google.com/) で無料のAPIキーを発行して設定。
# Free枠で毎日一定量の生成が無料。ここを空にするとデモ出力（サンプル）が返ります。
GEMINI_API_KEY=

# 使用モデル（省略時は gemini-flash-lite-latest＝最新ライトモデルを自動追従）
# GEMINI_MODEL=gemini-flash-lite-latest

# ===== 収益化（Stripe） =====
# Stripe の Payment Links で作成した各プラン決済URLを設定すると、
# 料金ページの各ボタンから直接決済できます（Vercelに設定）。
# Standard（¥500/月・おすすめ）と Pro（¥900/月）のリンクを分けて設定。
# 権限付与（Checkout）未設定時のフォールバックとして使われます。
NEXT_PUBLIC_STRIPE_STANDARD_LINK=
NEXT_PUBLIC_STRIPE_PRO_LINK=

# ===== 有料プラン権限付与（Stripe Checkout + Webhook） =====
# 設定すると、支払い完了をWebhookで受け取り、購入者の匿名IDに有料プラン権限を付与します。
# 未設定の場合は上記のPayment Linkフォールバックとなり、権限付与はされません。
STRIPE_SECRET_KEY=sk_test_xxxx                                        # Stripeシークレットキー
STRIPE_WEBHOOK_SECRET=whsec_xxxx                                      # Webhook署名シークレット
STRIPE_PRICE_STANDARD=price_xxx                                       # Standard(¥500)のPrice ID
STRIPE_PRICE_PRO=price_xxx                                            # Pro(¥900)のPrice ID

# ===== 利用制限（Upstash Redis / Vercel KV） =====
# Vercel の Redis (Upstash) インテグレーションを追加すると自動で設定されます。
# サーバー側で月次利用回数を記録し、Free枠の超過を API 側でも弾きます。
# 未設定の場合はサーバー側制限がスキップされ、クライアント（localStorage）のみで制限します。
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 表示用のProプラン価格（任意）
# NEXT_PUBLIC_PRO_PRICE=¥500/月

# ===== Supabase（ユーザー保存・将来拡張・任意） =====
# https://supabase.com/ の無料枠。BrandKitの保存履歴やライセンス管理に使えます。
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
